# Scratch, per the doc standard (doc-organize Mode C): research dumps,
# discussion logs and generated renderings are gitignored, not committed.
# Six doc types ship; raw/ is not one of them.
docs/features/*/raw/
pic/*
!pic/walter-worker-logo.png
# Anchored: an unanchored ".coworker/" also matches ".coworker/" at any depth,
# so a stray directory (e.g. a literal "~" path written by a bug) stayed
# invisible to git status while containing a real file.
/.coworker/
*.bak
.polish-loop-stop

# Project-specific — generated & experiments
experiments/
graphify-out/
.playwright-mcp/
.claude/hooks/

