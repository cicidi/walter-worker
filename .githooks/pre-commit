#!/usr/bin/env bash
# pre-commit: block commits that modify a SKILL.md without bumping its version: field.
set -euo pipefail

# Only run on staged SKILL.md files
STAGED_SKILLS=$(git diff --cached --name-only -- 'skills/*/SKILL.md' 2>/dev/null || true)
if [[ -z "$STAGED_SKILLS" ]]; then
    exit 0
fi

get_version() {
    # Extract version: VALUE from SKILL.md frontmatter (file or git object).
    local target="$1"
    if [[ "$target" == "HEAD:"* ]]; then
        local ref="${target#HEAD:}"
        git show "HEAD:$ref" 2>/dev/null | grep -m1 '^version:' | sed 's/version: *//' | xargs
    else
        grep -m1 '^version:' "$target" 2>/dev/null | sed 's/version: *//' | xargs
    fi
}

errors=0
for f in $STAGED_SKILLS; do
    # If file is new (not in HEAD), skip version-bump check
    if ! git cat-file -e "HEAD:$f" 2>/dev/null; then
        continue
    fi

    old_ver=$(get_version "HEAD:$f")
    new_ver=$(get_version "$f")

    if [[ -z "$new_ver" ]]; then
        echo "ERROR: $f — missing version: field in frontmatter"
        errors=$((errors + 1))
        continue
    fi

    # If content is unchanged vs HEAD, skip (version unchanged is fine)
    if git diff --cached "$f" 2>/dev/null | grep -qv '^[+-]version:' || true; then
        # Content beyond version changed — version must also change
        if [[ "$old_ver" == "$new_ver" ]]; then
            echo "ERROR: $f — body changed but version not bumped (was $old_ver)"
            errors=$((errors + 1))
        fi
    fi
done

if [[ $errors -gt 0 ]]; then
    echo ""
    echo "To bypass (not recommended): git commit --no-verify"
    exit 1
fi
exit 0
